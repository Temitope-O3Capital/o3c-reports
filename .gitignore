# One-off scripts with embedded secrets at repo root — never commit.
# Leading slash scopes each pattern to the root only (D9: don't ignore frontend/ package files).
/setup_db.js
/package.json
/package-lock.json

# Go build output
backend-go/reports

# Claude Code local settings
.claude/

# compiled Go backend
backend-go/o3c-backend.exe
backend-go/o3c-backend
backend-go/backend
backend-go/server

backend-go/frontend-dist/
backend-go/o3c-backend.exe~
backend-go/run_backend.ps1
backend-go/logs/

# Deploy trigger consumed by the keep-alive task — regenerated on every
# deploy, so tracking it dirties the tree after each restart.
backend-go/RESTART.flag

# Root build output (backend-go/frontend-dist is listed above)
/frontend-dist/

# Management report generator. Dry-run previews and SendGrid payloads carry recipient
# addresses and report figures; the Chrome profile and PNGs are phone-width checks.
scripts/management-reports/preview-*.html
scripts/management-reports/_payload-*.json
scripts/management-reports/_sql-*.sql
scripts/management-reports/*.png
scripts/management-reports/cdp-profile/
# Chart intermediates: one HTML page per chart, rendered to PNG and then re-read.
# Same throwaway status as the PNGs beside them, which were already ignored.
scripts/management-reports/_c-c-*.html
